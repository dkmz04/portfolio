    <div class="avatar mb-6">
      <div class="w-36 h-36 rounded-full">
        <img src="/profile.webp" alt="Dika Muhammad Azis" class="object-cover w-full h-full" />
      </div>
    </div>
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Dika Muhammad Azis</div>
    <div class="text-3xl py-3 font-bold">Control Systems &amp; Electronics Engineer</div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/dikama" target="_blank"> Let's connect!</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="mb-12 scroll-mt-20">
    <div class="text-3xl w-full font-bold mb-5">About</div>
    <div class="mb-8 text-justify">
      Engineering Physics graduate specializing in control systems, electronics, and industrial IoT.
      Experienced designing and deploying control algorithms (MPC, LQR, PID, RL) and vision-based localization.
      Trained in firmware, PCB design, and FPGA through the Korea Chamber of Commerce and Industry (KCCI) program.
      Creator and co-creator of 3 published academic papers.
    </div>

          <div class="text-3xl w-full font-bold mb-5">Education</div>
    <div class="rounded-xl border border-base-300 bg-base-100 p-5 mb-8">
      <!-- Degree, school, GPA -->
      <div class="flex flex-row items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold">Bachelor of Engineering, Engineering Physics (Instrumentation and Control)</h3>
          <p class="text-sm opacity-75 mt-0.5">
            Institut Teknologi Bandung (ITB), Bandung, Indonesia &middot; August 2022 &ndash; August 2026
          </p>
        </div>
        <div class="text-right shrink-0">
          <div class="text-3xl font-bold leading-none">3.68</div>
          <div class="text-xs opacity-75 mt-1">CGPA / 4.00</div>
        </div>
      </div>

      <div class="divider my-4"></div>

      <!-- Undergraduate thesis -->
      <div class="mb-5">
        <div class="text-xs font-semibold uppercase tracking-wide opacity-60 mb-1">Undergraduate Thesis</div>
        <p class="text-lg">
          Pothole Avoidance and Motion Planning for Autonomous Vehicles using Deep Reinforcement Learning within the
          CARLA Simulator
        </p>
        <a href="#projects" class="btn btn-xs btn-outline mt-2">View project &rarr;</a>
      </div>

            <!-- Publication -->
