    <div class="text-3xl w-full font-bold mb-5">Projects {"</>"}</div>

    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Project 1 -->
      <a href="/projects" class="block rounded-xl border border-base-300 bg-base-100 overflow-hidden hover:shadow-lg transition">
