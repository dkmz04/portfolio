          class="w-full aspect-video object-cover"
          loading="lazy"
        />
        <div class="p-4">
          <h3 class="font-bold">IIoT-Based 3-Axis Automated Storage and Retrieval System</h3>
          <p class="text-sm opacity-75 mt-2">
            Omron PLC ladder logic and Weintek HMI, with MQTT and Node-RED remote monitoring and PostgreSQL logging.
          </p>
        </div>
      </a>

     <!-- Project 3 -->
      <a href="/projects" class="block rounded-xl border border-base-300 bg-base-100 overflow-hidden hover:shadow-lg transition">
