        <img src="/projects/moza-r12/r1.png" alt="MATLAB steering feel simulation dashboard with virtual steering wheel" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r2.png" alt="Force feedback calculation architecture linking the model to MOZA parameters" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r3.png" alt="Block diagram of the supporting torque components" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r4.png" alt="MOZA Pit House software interface" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r5.png" alt="Maximum output torque limit versus normalized force" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r6.png" alt="FFB game force feedback intensity versus normalized force" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r7.png" alt="Simulated output torque and components for the turn-and-hold maneuver" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
      <div class="snap-start shrink-0 w-[80vw] sm:w-[45vw] md:w-[350px] lg:w-[450px]">
        <img src="/projects/moza-r12/r8.png" alt="Simulated output torque and components for active return" class="w-full h-48 md:h-[280px] object-cover rounded-xl shadow-sm border border-gray-200 dark:border-gray-700" loading="lazy" />
      </div>
    </div>
  </div>

</BaseLayout>

